# --- Anthropic (gera as buscas a partir do formulário) ---
# Sem a chave, o app usa um gerador de buscas por regras (funciona, mas fica menos criativo).
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-sonnet-5-5
ANTHROPIC_MODEL=

# --- Scraper da Shein (serviço /scraper) ---
# Opcional. Sem ela, o app pula o scraper e usa Google + links de busca.
SCRAPER_URL=
# Obrigatória se SCRAPER_URL estiver preenchida. Mesmo valor configurado no /scraper.
SCRAPER_TOKEN=

# --- Google via SerpAPI (anúncios reais quando o scraper não traz produtos) ---
# Opcional. Crie uma conta em https://serpapi.com (plano gratuito: 250 buscas/mês).
SERPAPI_KEY=
# Opcional. Quantas buscas de cada pesquisa podem consultar a SerpAPI. Padrão: 3
SERPAPI_MAX_TERMOS=

# --- Proteção ---
# Opcional. Pesquisas por minuto aceitas de um mesmo IP. Padrão: 6
LIMITE_BUSCAS_POR_MINUTO=
