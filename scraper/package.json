{
  "name": "dressfinder-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço que busca vestidos na Shein Brasil com Playwright",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "investigar": "tsx scripts/investigar.ts",
    "testar": "node --env-file-if-exists=.env --import tsx scripts/testar.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "playwright": "1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
